    xkb_layout "br"
    xkb_options "caps:escape"
}
input type:touchpad {
       dwt enabled
       tap enabled
       natural_scroll enabled
       middle_emulation enabled
   }

input type:touchpad {
	tap enabled
}

output * scale_filter linear

